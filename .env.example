# ── Populis API environment ──────────────────────────────────────────────────
# Copy to .env and fill in the REQUIRED values before booting the server.
# Operator docs:
#   ../populis_protocol/docs/TESTNET_SETUP.md       — chain bootstrap
#   ./README.md                                     — endpoint reference
#   ./GENESIS_README.md                             — first-time deployment
#   ./ADMIN_README.md                               — admin-desk operations
#   ./SECURITY.md                                   — full audit trail (POP-CANON-*)

# ── Network ─────────────────────────────────────────────────────────────────
# (testnet11 | mainnet).  coinset_base_url MUST match.
POPULIS_NETWORK=testnet11
POPULIS_COINSET_BASE_URL=https://testnet11.api.coinset.org

# ── REQUIRED: faucet key ─────────────────────────────────────────────────────
# Provide ONE of the three.  The faucet pays for every new vault launcher AND
# bankrolls the genesis deployment (PGT mint + 3 singleton launchers ≈ 1M+3
# mojos).  Fund from https://testnet11-faucet.chia.net/ — the API logs the
# bech32m address to send TXCH to on first boot.

# Option A: 32-byte hex master BLS private key (preferred for prod)
#POPULIS_FAUCET_MASTER_SK_HEX=

# Option B: 32-byte hex seed
#POPULIS_FAUCET_SEED_HEX=

# Option C: 12 or 24 word BIP-39 mnemonic
#POPULIS_FAUCET_MNEMONIC="twelve or twenty four words here please"

# Maximum mojos the faucet may spend per launcher (POP-CANON-009).
POPULIS_FAUCET_MAX_SPEND_MOJOS=10000000

# ── Challenge / auth ─────────────────────────────────────────────────────────
POPULIS_CHALLENGE_TTL_SECONDS=300

# ── Protocol deployment fallbacks ────────────────────────────────────────────
# These env values are FALLBACKS — once /admin/deploy/protocol writes a
# manifest, the API reads pool_launcher_id from the manifest on every
# request (POP-CANON-011), so admin redeploys take effect without restart.
#POPULIS_POOL_LAUNCHER_ID=
#POPULIS_GOVERNANCE_LAUNCHER_ID=
#POPULIS_DEPLOYMENT_MANIFEST_PATH=./deployment_manifest.json

# ── Vault registry persistence (POP-CANON-007) ───────────────────────────────
# SQLite database path; WAL mode enabled, survives process restart.
#POPULIS_VAULT_REGISTRY_PATH=./vault_registry.db

# ── Faucet UTXO consolidation worker (POP-CANON-008) ─────────────────────────
# Periodically merges fragmented faucet change UTXOs into one coin.
# Disabled by default — opt in for high-volume deployments.
POPULIS_FAUCET_CONSOLIDATION_ENABLED=false
POPULIS_FAUCET_CONSOLIDATION_THRESHOLD=50
POPULIS_FAUCET_CONSOLIDATION_INTERVAL_SECONDS=600
POPULIS_FAUCET_CONSOLIDATION_FEE=0
POPULIS_FAUCET_CONSOLIDATION_MAX_INPUTS=500

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (include your Angular dev server).
POPULIS_CORS_ORIGINS=http://localhost:4200,http://localhost:5173

# ── Admin desk (interactive operator UI) ─────────────────────────────────────
# The Admin Desk uses a wallet-pubkey allowlist + short-lived JWT.  See
# ADMIN_README.md for the full operations runbook.

# Comma-separated 0x-prefixed EVM addresses or BLS G1 hex pubkeys allowed to
# log in.  Empty = admin desk disabled (returns 503).  See SECURITY.md
# §POP-CANON-012 for the live re-check semantics.
#POPULIS_ADMIN_PUBKEY_ALLOWLIST=0xabc...,0x123...

# HS256 secret used to sign admin-desk JWTs.  Generate with
#   openssl rand -hex 32
# Empty = random per-process secret (fine for dev; tokens don't survive
# restart).  REQUIRED in production (POP-CANON-016).
#POPULIS_ADMIN_JWT_SECRET=

# JWT TTL (seconds).  Default 15 minutes; refresh via /admin/auth/refresh.
POPULIS_ADMIN_LOGIN_TOKEN_TTL_SECONDS=900

# ── One-shot admin token (legacy) ────────────────────────────────────────────
# Bearer token for /admin/deploy/protocol and other one-shot operator
# commands.  Distinct from the admin-desk JWT — used for the genesis-deploy
# bootstrap flow only.  Generate with: openssl rand -hex 32.
# Empty = those routes return 503 (safest default).
#POPULIS_ADMIN_TOKEN=

# Local http://localhost Genesis UI only.  Keep true/omitted in HTTPS
# production so the bootstrap session cookie is Secure.
#POPULIS_BOOTSTRAP_COOKIE_SECURE=false

# ── On-chain trust-root singletons (A.2 / A.3 / A.4) ─────────────────────────
# All optional.  Once you've deployed each singleton on-chain, set its
# launcher id here so the API surfaces it on /protocol (or
# /admin/auth/authority for A.2).  See SECURITY.md sections A.2..A.4 for
# the full operator deployment checklist.

# ── A.3 — Protocol-config singleton ──
# On-chain commitment to (pool_launcher_id, governance_launcher_id, network,
# config_version).  Surfaced on /protocol.protocol_config_hash so frontends
# can verify their published config against on-chain state.
#POPULIS_PROTOCOL_CONFIG_LAUNCHER_ID=

# ── A.2 — Admin-authority singleton ──
# m-of-n on-chain replacement for the admin allowlist + JWT secret model.
# Surfaced on GET /admin/auth/authority as a deterministic state_hash.
#POPULIS_PROTOCOL_ADMIN_AUTHORITY_LAUNCHER_ID=
#POPULIS_PROTOCOL_ADMIN_AUTHORITY_PUBKEYS=         # comma-separated BLS G1 hex
#POPULIS_PROTOCOL_ADMIN_AUTHORITY_QUORUM_M=1
#POPULIS_PROTOCOL_ADMIN_AUTHORITY_VERSION=1

# ── A.4 — Property-registry singleton ──
# Append-only on-chain log of registered property identifiers.  Surfaced
# on /protocol.property_registry_launcher_id so off-chain consumers can
# walk the lineage on coinset.org and rebuild the registered-property set.
#POPULIS_PROTOCOL_PROPERTY_REGISTRY_LAUNCHER_ID=

# (A.1 — Mint-proposal singletons — are per-proposal, not protocol-level;
# no env var.  Each proposal's launcher_id is the unique proposal id.
# /protocol exposes the canonical mint_proposal_mod_hash so clients can
# identify proposal singletons by uncurrying their inner reveal.)

# ── zkPassport validator node ─────────────────────────────────────────────────
# 32-byte hex seed for the BLS validator keypair that countersigns EVM
# VaultAttestationVerified events.  Generate with:
#   python3 -c "import secrets; print(secrets.token_bytes(32).hex())"
# Store in .env with mode 0600.  When unset, POST /zkpassport/sign returns 503.
#
# Testnet11 validator pubkey (derived from this seed — must match populis_protocol):
#   0xa8f9b0c1f992c49210fc726fc610885b966f84747126753659c6c3f8ae5bf3baf5b6e1a399fc8a749daf45dd74efac4c
# Bridge policy hash (curried puzzle hash — must match on-chain vault enrollment):
#   0xc87f45cd23d052c88256de8823a4a01f40da4e2066156f48f3b3dfc0a50350d7
#POPULIS_ZKPASSPORT_VALIDATOR_SEED_HEX=

# ── zkPassport gasless relayer (ERC-2771 meta-transactions) ──────────────────
# Lets alpha testers complete on-chain verification WITHOUT holding Sepolia ETH.
# The user still signs an EIP-712 ForwardRequest in their wallet (gasless); this
# funded key only pays gas to submit forwarder.execute().  When unset, POST
# /zkpassport/relay returns 503.  SECRET — store with mode 0600 (on testnet you
# may reuse the EVM deployer key from populis_evm/.env).
#POPULIS_ZKPASSPORT_RELAYER_PRIVATE_KEY_HEX=
# JSON-RPC endpoint + chain the relayer signs for (defaults shown).
#POPULIS_ZKPASSPORT_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
#POPULIS_ZKPASSPORT_EVM_CHAIN_ID=11155111
# ERC-2771 forwarder + emitter the relayer targets (alpha Sepolia deploy).
#POPULIS_ZKPASSPORT_FORWARDER_ADDRESS=0x84DBC9bcEDfD9920da91eDcfBeb0eebd44104aB3
#POPULIS_ZKPASSPORT_EMITTER_ADDRESS=0x77bD869AB5e363eb5Fe533B2852D1693C8448EdF
