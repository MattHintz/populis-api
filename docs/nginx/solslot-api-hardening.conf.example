# Reference controls for the public /protocol-api/ route.
#
# Define these zones once in nginx's http {} block:
#   limit_req_zone  $binary_remote_addr zone=solslot_api_rate:10m rate=10r/s;
#   limit_conn_zone $binary_remote_addr zone=solslot_api_conn:10m;

location /protocol-api/ {
    proxy_pass http://127.0.0.1:8790/;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;

    client_max_body_size 4m;
    client_body_timeout 15s;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    send_timeout 30s;

    limit_conn solslot_api_conn 20;
    limit_req zone=solslot_api_rate burst=30 nodelay;
}
